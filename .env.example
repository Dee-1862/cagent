# Copy to .env and fill in. Never commit .env.

# Gateway
UNSTEP_GATEWAY_HOST=0.0.0.0
UNSTEP_GATEWAY_PORT=8765
UNSTEP_EVENTS_PATH=data/events.jsonl
UNSTEP_CONTROLLER_ID=controller-1

# Elastic (leave empty to store events in UNSTEP_EVENTS_PATH instead)
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_EVENTS_INDEX=unstep-events
ELASTIC_WORKFLOW_URL=
