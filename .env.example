# Copy to .env and fill in. Never commit .env.
# Everything below the "Optional" line has a default in unstep/config.py.

# Keys
CARTESIA_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
ELASTIC_CLOUD_URL=
ELASTIC_API_KEY=

# Cartesia voices
CARTESIA_VOICE_ID=
CARTESIA_PRONUNCIATION_DICT_ID=

# Optional
# Gateway address every client connects to.
UNSTEP_GATEWAY_URL=ws://127.0.0.1:8765
# Shared secret. When set, every client and the dashboard must send it.
UNSTEP_GATEWAY_TOKEN=
# Seconds an undecided proposal stays open.
UNSTEP_PENDING_TTL_S=60
# Defaults to ELASTIC_CLOUD_URL with .es. replaced by .kb.
# The API key must work on both Elasticsearch and Kibana (Agent Builder, Workflows).
KIBANA_URL=
ELASTIC_EVENTS_INDEX=unstep-events
CARTESIA_VERSION=2026-08-14
CARTESIA_STT_MODEL=ink-2
CARTESIA_STT_TIMESTAMP_MODEL=ink-whisper
CARTESIA_TTS_MODEL=sonic-3.6
# 1 = pace replays to the manual STT endpoint at real time (off: send fast, see docs/09).
UNSTEP_REALTIME_REPLAY=0
# 0 = listeners hear clean audio instead of VHF-shaped radio.
UNSTEP_RADIO_SOUND=1
MOSS_INFERENCE_MODEL=moss

# Optional password for the Control Tower seat at /live/atc/ (blank leaves it open)
UNSTEP_ATC_PASSWORD=
# Live room for a crowd. Pilot app hosted elsewhere (Vercel): its origin, comma separated, * allowed.
UNSTEP_ALLOWED_ORIGINS=
# How many fleet aircraft people can join as (max 6) and how many get a Moss session.
UNSTEP_MAX_AIRCRAFT=6
UNSTEP_MOSS_AIRCRAFT=6
# Seconds a connected pilot can do nothing before the flight counts as landed and the seat is freed (0 = never)
UNSTEP_IDLE_LAND_S=600
